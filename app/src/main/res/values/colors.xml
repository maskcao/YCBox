<?xml version="1.0" encoding="utf-8"?>
<resources>


    <!--应用的主要色调,actionBar默认使用该颜色,Toolbar导航栏的底色-->
    <color name="colorPrimary">#FF1A1A20</color>
    <!--CheckBox,RadioButton,SwitchCompat等一般控件的选中效果默认采用该颜色-->
    <color name="colorAccent">#FFC68500</color>
    <!--    默认window窗口(activity)背景颜色-->
    <color name="windowBackground">#FFFFFFFF</color>

    <!--    浅色模式下不能与 windowBackground 同为纯白：所有以 bg_gray 为底的
         卡片/列表容器（设置分组、订阅列表、直播分组、详情、搜索热词…）会直接"糊"在
         白底上看不出边界。改成极浅灰，且**留一点透明度** —— 这样开了壁纸时
         卡片能透出壁纸背景（半透明色叠在纯色页面底上，与不透明时观感几乎一致）。
         夜间模式见 values-night/colors.xml。-->
    <color name="bg_gray">#FFE3E3E3</color>
    <color name="gray_darker">#FF5E5E66</color>
    <!--    深灰点击透明度-->
    <color name="gray_darker_press_alpha">#FFE5E5E8</color>

    <!--    通用颜色-->
    <color name="white">#FFFFFFFF</color>
    <color name="black">#FF000000</color>
    <color name="text_foreground">#FF000000</color>
    <color name="text_sub_foreground">#FF5A5A60</color>
    <color name="light_gray_color">#FF707078</color>
    <!--    警示黄色-->
    <color name="warn">#FFC97A00</color>
    <color name="red">#FFC92020</color>

    <color name="disable_text">#FF9A9AA0</color>

    <!--    带点透明度(e6 90/100不透明)的pop-->
    <color name="bg_popup">#FFFFFFFF</color>

    <!--    制定颜色-->
    <!--    页面背景色,activity.fragment等-->
    <color name="bg_page">#FFFFFFFF</color>
    <!--    不可用灰色颜色-->
    <color name="disable_gray">#FFC0C0C8</color>

    <color name="orange">#FFD45520</color>
    <!-- dock 选中态取色（方块背景与选中标签），用户指定 #C68500 -->
    <color name="dock_accent">#C68500</color>
    <!-- 「我的」页功能磁贴芯片配色：bg 为半透明同色系底，fg 为图标色 -->
    <color name="chip_blue_fg">#FF2962FF</color>
    <color name="chip_blue_bg">#332962FF</color>
    <color name="chip_orange_fg">#FFF57C00</color>
    <color name="chip_orange_bg">#33F57C00</color>
    <color name="chip_red_fg">#FFE53935</color>
    <color name="chip_red_bg">#33E53935</color>
    <color name="chip_pink_fg">#FFD81B60</color>
    <color name="chip_pink_bg">#33D81B60</color>
    <color name="chip_green_fg">#FF00897B</color>
    <color name="chip_green_bg">#3300897B</color>
    <color name="chip_purple_fg">#FF673AB7</color>
    <color name="chip_purple_bg">#33673AB7</color>
    <!-- 订阅条目圆形单选未选中的圆环色（浅色深灰环 / 夜间浅灰环） -->
