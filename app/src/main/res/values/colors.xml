    <!-- 「上次观看」提示的渐变底色：不随主题变为白色，
         否则深色模式下会变成白底白字（原实现用 colorPrimary/colorAccent 渐变所致） -->
    <color name="last_viewed_gradient_start">#1A1A20</color>
    <color name="last_viewed_gradient_end">#C68500</color>
    <!-- 强调实色（按钮等大面积填充）：两主题一致，避免深色下 colorPrimary=白 造成白块 -->
    <color name="accent_solid">#C68500</color>
    <!-- 琥珀金底上的文字色。白色在 #C68500 上对比度仅 3.1:1（贴无障碍下限），
         改用深墨色后约 5.4:1。两主题通用，故只定义在 values/ 下。 -->
    <color name="on_accent_text">#FF1A1A20</color>

    <!-- 浅色模式的可辨识表面：bg_gray 与 windowBackground 同为 #FFFFFF，
         搜索框、卡片直接用它会"糊"在白底上看不出边界，这里给出略微可辨的底色+描边 -->
    <color name="bg_surface">#FFF7F7F9</color>
    <color name="bg_field">#FFF1F1F4</color>
    <color name="stroke_subtle">#1F000000</color>

