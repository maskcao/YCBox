<?xml version="1.0" encoding="utf-8"?>
<!-- 订阅条目（参考样式）：独立圆角卡片，圆形单选 + 名称/来自标签/删除圆钮，地址在名称下方 -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/item"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card_rounded"
    android:padding="12dp">

    <!-- 圆形单选：用 ImageView + 显式两张图（radio_on/radio_off），避免 CheckBox 被主题 tint 染色；
         相对名称行+地址行整体垂直居中 -->
    <ImageView
        android:id="@+id/cb"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:clickable="false"
        android:focusable="false"
        android:src="@drawable/radio_off"
        app:layout_constraintBottom_toBottomOf="@id/tv_url"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/ll_name_row" />

    <!-- 名称行：名称占满剩余宽度，右侧标签整体右对齐。
         注意这里不能用 LinearLayout + weight：0dp+weight 在 0dp 宽的父容器里不生效，
         名称会被钉死在 142dp，直播订阅名（重命名允许 12 字 ≈ 180dp）必然被截断。
         也不要用 ConstraintLayout 链：标签 GONE 时链上的位置解析会退化，宽度同样不可控。
         现在的结构是单向依赖——名称只依赖标签容器，标签不依赖名称，没有环。 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ll_name_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        app:layout_constraintEnd_toStartOf="@id/iv_pushpin"
        app:layout_constraintStart_toEndOf="@id/cb"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/gl_tags"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.70" />

        <TextView
            android:id="@+id/tv_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:lineSpacingExtra="1dp"
            android:maxLines="2"
            android:textColor="@color/text_foreground"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/gl_tags"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="小账订阅小账订阅小账订阅" />

        <!-- 「内置」标签：必须放在 ConstraintLayout 里而不是 ll_tags 里。
             LinearLayout 里 GONE 的子 view 仍会占掉它自己的测量宽度（约 78px），
             名称会被白白挤窄 30dp，长中文名就会多折一行 -->
        <TextView
            android:id="@+id/tv_builtin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_tag_builtin"
            android:text="内置"
            android:textColor="@color/accent_solid"
            android:textSize="11dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/tv_name"
            app:layout_constraintEnd_toStartOf="@id/ll_tags"
            app:layout_constraintTop_toTopOf="@id/tv_name"
            tools:visibility="visible" />

        <!-- 标签容器：跟随在名称右侧、贴右对齐；constrainedWidth 让它在名称与右边缘
             之间自适应——名称短时标签完整展开，名称长时才收缩（内容自身再省略）。
             标签 GONE 时整体宽度为 0，名称就自动铺满整行 -->
        <LinearLayout
            android:id="@+id/ll_tags"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:orientation="horizontal"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintStart_toEndOf="@id/tv_name"
            app:layout_constraintTop_toTopOf="@id/tv_name">

            <!-- 「来自：xxx」小标签（仅直播订阅显示）：半透明蓝圆角。
                 不再限死 maxWidth（72dp 连"来自：订阅: 2"都装不下，必截断），
                 宽度由上面的容器按剩余空间分配，只有名称真的很长时才会省略 -->
            <TextView
                android:id="@+id/tv_from"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tag_from"
                android:ellipsize="end"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:singleLine="true"
                android:textColor="@color/chip_blue_fg"
                android:textSize="10sp"
                android:visibility="gone"
                tools:text="来自：订阅 6"
                tools:visibility="visible" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 地址：名称正下方，与名称左对齐（锚在名称行底部，避免与 cb 循环约束） -->
    <TextView
        android:id="@+id/tv_url"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="3dp"
        android:ellipsize="middle"
        android:singleLine="true"
        android:textColor="@color/text_sub_foreground"
        android:textSize="12sp"
        app:layout_constraintEnd_toStartOf="@id/iv_pushpin"
        app:layout_constraintStart_toEndOf="@id/cb"
        app:layout_constraintTop_toBottomOf="@id/ll_name_row"
        tools:text="https://" />

    <ImageView
        android:id="@+id/iv_del"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/bg_del_circle"
        android:padding="7dp"
        android:src="@drawable/dkplayer_ic_action_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/chip_red_fg"/>

    <ImageView
        android:id="@+id/iv_pushpin"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="6dp"
        android:padding="6dp"
        android:src="@drawable/ic_pushpin"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@id/iv_del"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/chip_red_fg"
        tools:visibility="visible"/>

</androidx.constraintlayout.widget.ConstraintLayout>
