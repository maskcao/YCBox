<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/item"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="10dp">

    <CheckBox
        android:id="@+id/cb"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:checked="false"
        android:focusable="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 名称行: 宽度由 cb 与删除按钮之间的实际间距决定,名称过长自动省略,
         来源标记优先完整显示 -->
    <LinearLayout
        android:id="@+id/ll_name_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toStartOf="@id/iv_pushpin"
        app:layout_constraintStart_toEndOf="@id/cb"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:textSize="16dp"
            android:ellipsize="end"
            android:marqueeRepeatLimit="marquee_forever"
            tools:text="小账订阅小账订阅小账订阅"
            android:textColor="@color/text_foreground" />

        <TextView
            android:id="@+id/tv_builtin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_marginRight="6dp"
            android:background="@drawable/bg_tag_builtin"
            android:text="内置"
            android:textColor="@color/accent_solid"
            android:textSize="11dp"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tv_from"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:maxWidth="150dp"
            android:textColor="@color/text_sub_foreground"
            android:textSize="11dp"
            android:visibility="gone"
            tools:text="来自：订阅 6"
            tools:visibility="visible" />

    </LinearLayout>

    <TextView
        android:id="@+id/tv_url"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="middle"
        android:singleLine="true"
        tools:text="https://"
        app:layout_constraintEnd_toStartOf="@id/iv_pushpin"
        app:layout_constraintStart_toEndOf="@id/cb"
        app:layout_constraintTop_toBottomOf="@id/ll_name_row" />

    <ImageView
        android:id="@+id/iv_del"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:paddingHorizontal="6dp"
        android:src="@drawable/dkplayer_ic_action_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/red"/>

    <ImageView
        android:id="@+id/iv_pushpin"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:paddingHorizontal="6dp"
        android:src="@drawable/ic_pushpin"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@id/iv_del"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/red"
        tools:visibility="visible"/>

</androidx.constraintlayout.widget.ConstraintLayout>
