<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="vertical">

    <!-- 顶部一行：历史 / 收藏 居中，右侧为清空当前分类。
         不再单独放大标题，tab 行直接占用标题原来的位置。 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:paddingHorizontal="12dp">

        <!-- 分类 tab：与首页同款 DslTabLayout（闪动指示条），宽度自适应并水平居中 -->
        <com.angcyo.tablayout.DslTabLayout
            android:id="@+id/tab_layout"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="center_horizontal|center_vertical"
            android:background="@android:color/transparent"
            app:tab_enable_gradient_text_size="false"
            app:tab_indicator_drawable="@drawable/indicator_flash"
            app:tab_indicator_enable_flash="true"
            app:tab_indicator_enable_flash_clip="true"
            app:tab_indicator_height="5dp"
            app:tab_indicator_width="16dp"
            app:tab_select_color="@color/colorPrimary"
            app:tab_text_max_size="16dp"
            app:tab_text_min_size="14dp" />

        <ImageView
            android:id="@+id/iv_clear"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical|end"
            android:alpha="0.75"
            android:background="?android:selectableItemBackgroundBorderless"
            android:contentDescription="清空"
            android:padding="8dp"
            android:src="@drawable/ic_clear"
            app:tint="@color/text_foreground" />
    </FrameLayout>

    <TextView
        android:id="@+id/top_tip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginVertical="10dp"
        android:text="长按记录逐条删除"
        android:textColor="@color/text_sub_foreground"
        android:visibility="gone"
        tools:visibility="visible" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/mGridView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="10dp"
        android:paddingTop="10dp" />
</LinearLayout>
