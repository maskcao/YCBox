<?xml version="1.0" encoding="utf-8"?>
<!-- 首页顶部 chrome 参考 NewBox：订阅 / 当前源 / 搜索三枚玻璃胶囊 + 玻璃分类栏。
     整块是浮在内容之上的透明图层，hero 轮播的大图一路顶到状态栏，胶囊压在图上。
     布局里的 bg_glass_capsule 只是兜底：HomeFragment.init() 会把四枚胶囊的背景换成
     GlassBackdrop 的实时磨砂（和 NewBox 的 GlassCapsule 一样，每枚各自模糊自己背后）。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <FrameLayout
        android:id="@+id/contentLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.viewpager.widget.ViewPager
            android:id="@+id/mViewPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

    <!-- 顶栏浮层：自身不消费点击，胶囊之间的空隙能直接点到下面的图 -->
    <LinearLayout
        android:id="@+id/topLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:clickable="false"
        android:focusable="false"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="44dp">

        <!-- 顶栏第一行：订阅胶囊 + 当前源胶囊 + 搜索。
             两枚胶囊用 packed 链 + constrainedWidth：文字短时各自贴边、互不撑大，
             名称长到一行装不下时按各自宽度等比压缩，谁都不会把对方挤出去。 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false">

            <!-- 订阅入口：显示当前生效的订阅名（HomeFragment 里赋值），点击弹底部面板 -->
            <TextView
                android:id="@+id/subContainer"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_glass_capsule"
                android:contentDescription="订阅"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingHorizontal="10dp"
                android:text="订阅"
                android:textColor="@color/text_foreground"
                android:textSize="13sp"
                android:textStyle="bold"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toStartOf="@id/nameContainer"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- 当前首页源：点击切源，长按刷新订阅；logo 由配置决定，未声明时隐藏 -->
            <LinearLayout
                android:id="@+id/nameContainer"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_glass_capsule"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toStartOf="@id/search"
                app:layout_constraintStart_toEndOf="@id/subContainer"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/ivSourceLogo"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="4dp"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="4dp"
                    android:drawableRight="@drawable/ic_arrow_down"
                    android:drawableTint="@color/text_sub_foreground"
                    android:ellipsize="marquee"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:singleLine="true"
                    android:text="@string/app_name"
                    android:textColor="@color/text_foreground"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <ImageView
                android:id="@+id/search"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_glass_capsule"
                android:contentDescription="搜索"
                android:padding="7dp"
                android:src="@drawable/ic_search_18"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/text_foreground" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 分类栏：玻璃胶囊包住 DslTabLayout，选中金色、无下划线（NewBox 样式） -->
        <FrameLayout
            android:id="@+id/tabGlassBar"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="6dp"
            android:clipChildren="false"
            android:background="@drawable/bg_glass_capsule">

            <com.angcyo.tablayout.DslTabLayout
                android:id="@+id/tab_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="4dp"
                app:tab_deselect_color="@color/text_sub_foreground"
                app:tab_draw_indicator="false"
                app:tab_enable_gradient_text_size="false"
                app:tab_item_default_height="32dp"
                app:tab_select_color="@color/dock_accent"
                app:tab_text_max_size="15dp"
                app:tab_text_min_size="15dp" />

        </FrameLayout>

    </LinearLayout>

</FrameLayout>
