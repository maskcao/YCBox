<?xml version="1.0" encoding="utf-8"?>
<!-- 视频海报卡（参考样式，网格版）：宽度铺满格子 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:orientation="vertical">

    <!-- ShadowLayout 构造里会 setClickable(true)（XML 覆盖无效，实测仍为 true），
         会吃掉整块封面区域的触摸，导致 adapter 挂在根布局上的点击收不到，
         表现为「点海报图片没反应、只有底部标题能点」。
         对策：给它设 id，由 adapter 把点击转发给根布局（见 GridAdapter）。 -->
    <com.lihang.ShadowLayout
        android:id="@+id/shadowPoster"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        app:hl_cornerRadius="14dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/ivThumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/tvNote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_alignParentStart="true"
                android:layout_margin="6dp"
                android:background="@drawable/bg_rating_pill"
                android:ellipsize="end"
                android:maxWidth="90dp"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:singleLine="true"
                android:textColor="@color/white"
                android:textSize="10sp"
                tools:text="9.3" />

            <TextView
                android:id="@+id/tvYear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_margin="6dp"
                android:background="@drawable/bg_rating_pill"
                android:ellipsize="end"
                android:maxWidth="70dp"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:singleLine="true"
                tools:text="2026"
                android:textColor="@color/white"
                android:textSize="10sp" />
        </RelativeLayout>
    </com.lihang.ShadowLayout>

    <TextView
        android:id="@+id/tvName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:paddingHorizontal="2dp"
        android:singleLine="true"
        android:textColor="@color/text_foreground"
        android:textSize="13sp"
        tools:text="肖申克的救赎" />

</LinearLayout>
