<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="30dp"
    android:paddingVertical="20dp"
    android:background="@drawable/bg_large_round_popup">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="底部导航栏"
        android:textColor="@color/text_foreground"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="首页和「我的」始终显示，不可隐藏"
        android:textColor="@color/text_sub_foreground"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/llDockLive"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:foreground="?android:selectableItemBackground">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="直播"
            android:textColor="@color/text_foreground"
            android:textSize="15sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchDockLive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llDockHistory"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:foreground="?android:selectableItemBackground">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="历史/收藏"
            android:textColor="@color/text_foreground"
            android:textSize="15sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchDockHistory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirm"
        android:layout_width="match_parent"
        android:layout_height="33dp"
        android:layout_marginTop="14dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="完 成"
        app:strokeColor="@color/colorPrimary"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

</LinearLayout>
