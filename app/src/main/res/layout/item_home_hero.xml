<?xml version="1.0" encoding="utf-8"?>
<!-- 首页 hero：通栏大图轮播，底边居中一栏文字（片名 / 元信息 / 指示器）。
     高度在 HeroVH 里按外层列表视口 * HERO_VIEWPORT_RATIO 动态设定，XML 里的 360dp
     只是预览占位。

     底边只有一层：HeroFadeLayout 把底边 96dp 连图一起溶成透明，直接透出壁纸。
     这里以前还压了一条 320dp 的暗带垫文字，但 hero 压到视口六成出头之后它仍盖住
     大半张可见海报，整张图糊成一片灰黑；而它最暗的一档正好落在被溶掉的那一段里，
     压了也白压。想留下暗带又不糊图，就得把它的最暗处顶到溶边上沿，那等于在图片
     中间挂一条黑杠——所以暗带整条删掉。

     文字块整块压在雾化带上，字色按主题成对翻转（@color/hero_caption_*）：这一段
     透出的是壁纸，不再是海报，所以不给字加描影 —— 实测 20dp 的描影在深色海报上
     糊成一团黑雾，比它换来的可读性显眼得多。指示器另有一条半透明胶囊，
     底色和点色成对翻转。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/heroRoot"
    android:layout_width="match_parent"
    android:layout_height="360dp"
    android:descendantFocusability="blocksDescendants"
    android:focusable="false"
    android:clipChildren="true">

    <com.github.tvbox.osc.ui.widget.HeroFadeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/heroPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <View
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_gravity="top"
            android:background="@drawable/bg_hero_top_scrim" />

    </com.github.tvbox.osc.ui.widget.HeroFadeLayout>

    <LinearLayout
        android:id="@+id/heroCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="2dp">

        <TextView
            android:id="@+id/heroTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/hero_caption_title"
            android:textSize="24sp"
            android:textStyle="bold"
            tools:text="庆余年 第二季" />

        <TextView
            android:id="@+id/heroNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/hero_caption_note"
            android:textSize="15sp"
            tools:text="评分：8.6 · 2024 · 内地 · 古装" />

        <LinearLayout
            android:id="@+id/heroDots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_hero_dots"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="8dp"
            android:paddingTop="5dp"
            android:paddingRight="8dp"
            android:paddingBottom="5dp" />

    </LinearLayout>

</FrameLayout>
