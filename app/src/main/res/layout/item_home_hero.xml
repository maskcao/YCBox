<?xml version="1.0" encoding="utf-8"?>
<!-- 首页 hero：通栏大图轮播，底边居中一栏文字（片名 / 元信息 / 指示器）。
     高度在 HeroVH 里按外层列表视口 * HERO_VIEWPORT_RATIO 动态设定，XML 里的 360dp
     只是预览占位。

     底边只有一层：HeroFadeLayout 把底边 56dp 连图一起溶成透明，直接透出壁纸，
     不留硬边。以前这条带子是 96dp 且收得很急，海报自带的深色底角被抹成半透明后
     浮在带上，看着就是左右两团发虚的黑影；现在只收底边一小段，图还是那张图。
     （更早还压过一条 320dp 的暗带垫文字，hero 压到视口六成出头之后它盖住大半张
     可见海报，整张图糊成一片灰黑——所以暗带整条删掉。）

     片名和评分压在海报上，只有最底一段跟着溶进壁纸。海报明暗不固定，两种主题都得
     看清：字色和描影按主题成对翻转（@color/hero_caption_*），描影永远比字更亮或更
     暗，相当于给字套一圈光环。指示器另有一条半透明胶囊，底色和点色成对翻转。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/heroRoot"
    android:layout_width="match_parent"
    android:layout_height="360dp"
    android:descendantFocusability="blocksDescendants"
    android:focusable="false"
    android:clipChildren="true">

    <com.github.tvbox.osc.ui.widget.HeroFadeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/heroPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <View
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_gravity="top"
            android:background="@drawable/bg_hero_top_scrim" />

    </com.github.tvbox.osc.ui.widget.HeroFadeLayout>

    <LinearLayout
        android:id="@+id/heroCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="2dp">

        <TextView
            android:id="@+id/heroTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:shadowColor="@color/hero_caption_shadow"
            android:shadowDx="0"
            android:shadowDy="3"
            android:shadowRadius="20"
            android:textColor="@color/hero_caption_title"
            android:textSize="24sp"
            android:textStyle="bold"
            tools:text="庆余年 第二季" />

        <TextView
            android:id="@+id/heroNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:shadowColor="@color/hero_caption_shadow"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="16"
            android:textColor="@color/hero_caption_note"
            android:textSize="15sp"
            tools:text="评分：8.6 · 2024 · 内地 · 古装" />

        <LinearLayout
            android:id="@+id/heroDots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_hero_dots"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="8dp"
            android:paddingTop="5dp"
            android:paddingRight="8dp"
            android:paddingBottom="5dp" />

    </LinearLayout>

</FrameLayout>
