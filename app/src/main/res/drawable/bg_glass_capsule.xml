<?xml version="1.0" encoding="utf-8"?>
<!-- 静态玻璃胶囊（无实时模糊）：不透明底 + 1dp 描边，配色与 GlassBackdrop 的
     磨砂表面一致，这样兜底态和磨砂态视觉上不跳。首页顶栏四枚胶囊在 HomeFragment
     里会被换成实时磨砂，分区标题条这类表面继续用这张。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/glass_fill_static" />
    <corners android:radius="16dp" />
    <stroke
        android:width="1dp"
        android:color="@color/glass_stroke" />
</shape>
