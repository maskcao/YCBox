<?xml version="1.0" encoding="utf-8"?>
<!-- 悬浮药丸 dock：底色在 MainActivity 里按壁纸底部取样色着色（无壁纸时用 dock_bg），
     使 dock 与背景同色相；细描边负责交代边界，避免实色块与壁纸割裂 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/dock_bg" />
    <corners android:radius="28dp" />
    <stroke
        android:width="1dp"
        android:color="@color/stroke_subtle" />
</shape>
