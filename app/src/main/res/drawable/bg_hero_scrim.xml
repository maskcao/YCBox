<?xml version="1.0" encoding="utf-8"?>
<!-- hero 底部压暗：给片名/评分/指示器垫一条暗带。
     从底边最暗往上单调渐隐（angle=90 时 startColor 在最下面）。
     不要做成「中间最深、两头透明」：那样暗度在图片中间出现一个局部峰值，
     在亮海报上就是一条悬浮的黑杠，比原来的硬边还显眼。
     这条带子放在 HeroFadeLayout 里面，底边那截会跟着图片一起被溶成透明，
     所以最暗处不会堵在接缝上。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:centerColor="#66000000"
        android:endColor="#00000000"
        android:startColor="@color/hero_scrim" />
</shape>
