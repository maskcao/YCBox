<?xml version="1.0" encoding="utf-8"?>
<!-- 输入框/搜索框：与 bg_card_outline 同思路，底色略深一点，描边让它在白底上立得住 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/bg_field" />
    <stroke
        android:width="1dp"
        android:color="@color/stroke_subtle" />
    <corners android:radius="18dp" />
</shape>
